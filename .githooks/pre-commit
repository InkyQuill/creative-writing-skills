#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
# Bypass a single commit: git commit --no-verify

set -uo pipefail

export PYTHONDONTWRITEBYTECODE=1
fail=0

echo "pre-commit: unit tests..."
if ! python3 -m unittest discover -s tests; then
  fail=1
fi

echo "pre-commit: distribution validation..."
if ! python3 scripts/validate_distribution.py; then
  fail=1
fi

echo "pre-commit: Claude distribution drift..."
if ! python3 scripts/sync_claude_distribution.py --check; then
  fail=1
fi

echo "pre-commit: Claude.ai skill packages..."
if ! python3 scripts/create_skill_zips.py; then
  fail=1
fi

if command -v claude >/dev/null 2>&1; then
  echo "pre-commit: Claude marketplace validation..."
  if ! claude plugins validate .claude-plugin/marketplace.json; then
    fail=1
  fi
  echo "pre-commit: Claude plugin validation..."
  if ! claude plugins validate cw; then
    fail=1
  fi
else
  echo "pre-commit: 'claude' not on PATH — skipping Claude CLI validation." >&2
fi

if [ "${fail}" -ne 0 ]; then
  echo >&2
  echo "pre-commit: checks failed. Fix the above, or bypass with 'git commit --no-verify'." >&2
  exit 1
fi

echo "pre-commit: ok."
